{
  "name": "vlaw-tray",
  "version": "0.2.0-beta",
  "description": "V-LAW system tray widget",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "node-cron": "^4.6.0"
  },
  "build": {
    "appId": "com.getvvault.vlaw",
    "productName": "V-LAW",
    "win": {
      "target": "dir",
      "icon": "assets/app_icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "flyout.html",
      "flyout.css",
      "flyout.js",
      "assets/**"
    ],
    "extraResources": [],
    "asar": true
  }
}
